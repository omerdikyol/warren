# Every variable the dev box expects. Copy to ~/.config/dev/*.env on tezb,
# fill in, and chmod 600. Nothing here is ever committed (AGENTS.md rule 2).

# ~/.config/dev/github.env  — source control
# A dedicated key generated on tezb, added to GitHub. Do not copy the Mac's key.
GIT_SSH_COMMAND="ssh -i ~/.ssh/id_ed25519_dev -o IdentitiesOnly=yes"
GITHUB_TOKEN=            # fine-grained PAT, only the repos the box pushes to

# ~/.config/dev/agents.env  — agent CLIs, all optional
CLAUDE_CODE_OAUTH_TOKEN= # printed by "claude setup-token" on a machine with a browser
OPENAI_API_KEY=          # only if you use the API instead of the Codex ChatGPT login
ANTHROPIC_API_KEY=       # only if you use the API instead of the Claude login

# ~/.config/dev/models.env  — the local model gateway (see local-ai-stack/README.md)
LOCAL_AI_BASE_URL="https://your-gateway.your-tailnet.ts.net/v1"
LOCAL_AI_API_KEY="tailscale-private"   # placeholder; the gateway does not validate it

